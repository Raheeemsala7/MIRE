# Server-only API base URL, including the API prefix (no trailing slash required).
# Fallback base for authentication requests made by the Next.js server.
API_URL=http://localhost:5000/api/v1

# Full API base path (including /api/v1). API_URL remains supported.
BACKEND_API_URL=http://localhost:5000/api/v1
# Use a MongoDB database dedicated to Next.js sessions or the existing app database.
SESSION_MONGODB_URI=mongodb://localhost:27017/mire_ecommerce
# Generate separately: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
