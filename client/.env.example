# Server-only Backend API URL.
# In development: defaults to http://localhost:5000/api/v1 if unset.
# In production: set this to your deployed backend API URL (e.g., https://api.mire.com/api/v1).
BACKEND_API_URL=http://localhost:5000/api/v1
API_URL=http://localhost:5000/api/v1

# MongoDB URI dedicated to Next.js sessions or the shared app database.
SESSION_MONGODB_URI=mongodb://localhost:27017/mire_ecommerce

# NextAuth / Auth session signing secret (e.g. openssl rand -base64 32)
AUTH_SECRET=replace-with-a-random-secret

# AES-256 token encryption key (32 bytes base64-encoded, e.g. openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
