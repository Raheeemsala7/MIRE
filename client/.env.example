# Server-only Backend API URL.
# In development: defaults to http://localhost:5000/api/v1 if unset.
# In production: set this to your deployed backend API URL (e.g., https://mire-fqdw.vercel.app/api/v1).
BACKEND_API_URL=http://localhost:5000/api/v1
API_URL=http://localhost:5000/api/v1

# NextAuth / Auth session signing secret (e.g. openssl rand -base64 32)
AUTH_SECRET=replace-with-a-random-secret
